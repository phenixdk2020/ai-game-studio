{
  "schemaVersion": 1,
  "require_project": true,
  "project_registry": "config/projects.json",
  "jobs_root": "data/pipeline-jobs",
  "repository": "phenixdk2020/ai-game-studio",
  "base_branch": "main",
  "default_code_backend": "copilot-local",
  "github_executable": "gh",
  "copilot_executable": "copilot",
  "git_executable": "git",
  "command_timeout": 1800,
  "poll_seconds": 30,
  "validation_commands": [
    [
      "python",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tests",
      "-v"
    ]
  ],
  "roles": [
    "project_manager",
    "historical_research",
    "technical_research",
    "character3d",
    "rigging",
    "animation",
    "gameplay",
    "unreal",
    "qa",
    "integration",
    "environment",
    "art_world"
  ],
  "claude_executable": "claude",
  "claude_ollama": {
    "base_url": "http://127.0.0.1:11434",
    "model": "qwen3.6:35b-a3b-coding",
    "tool_capabilities": ["image_generation", "image_to_3d", "animation"],
    "context_tokens": 65536,
    "max_output_tokens": 8192
  }
}
